APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://multi-tenancy-api.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Frontend app URL (Next.js) — used for post-payment redirects and cancel links
FRONTEND_URL=http://localhost:3000

# Payment providers (platform-level keys for self-service signup)
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Paystack redirects here first; API verifies payment then sends the browser to CHECKOUT_FRONTEND_SUCCESS_URL
CHECKOUT_SUCCESS_URL="${APP_URL}/api/central/payments/paystack/callback"
CHECKOUT_FRONTEND_SUCCESS_URL="${FRONTEND_URL}/onboard/success"
CHECKOUT_CANCEL_URL="${FRONTEND_URL}/onboard/cancel"

# Paystack card verification amount during trial signup (kobo). Minimum ₦100 = 10000.
PAYSTACK_TRIAL_SETUP_AMOUNT=10000
# Payment channels for Paystack checkout (comma-separated). Use card for saved authorizations.
PAYSTACK_CHANNELS=card
# Minimum Paystack charge in kobo (₦100 = 10000)
PAYSTACK_MIN_AMOUNT=10000

# Days before trial end to send reminder email
TRIAL_REMINDER_DAYS=3

# Stancl tenancy — central app hostnames (comma-separated)
CENTRAL_DOMAINS=127.0.0.1,localhost,multi-tenancy-api.test

# Default suffix for new tenant domains: {slug}.multi-tenancy-api.test
TENANT_DOMAIN_BASE=multi-tenancy-api.test

# Tenant owner links in welcome email; {domain} is replaced with the tenant hostname
TENANT_OWNER_LOGIN_URL=http://{domain}/admin/login
TENANT_OWNER_PASSWORD_SETUP_URL=http://{domain}/admin/set-password

# Self-onboarding runs tenant migrations synchronously; allow extra time (seconds)
SELF_ONBOARDING_MAX_EXECUTION_TIME=600

# Queue tenant DB setup so self-onboarding returns quickly (requires: php artisan queue:work)
TENANCY_QUEUE_TENANT_CREATION=true

# Real-time central admin updates (requires: php artisan reverb:start)
BROADCAST_CONNECTION=reverb
